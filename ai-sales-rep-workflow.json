    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead name: {{ $json.name }}\nSource: {{ $json.source }}\nLead message: {{ $json.message }}",
        "options": {
          "systemMessage": "You are a friendly, professional AI sales assistant for a business. A new lead has just come in.\nYour tasks:\n1. Use the knowledge base tool to answer any question the lead asked. Never invent prices or facts.\n2. Qualify the lead: need, budget, timeline.\n3. Score the lead from 1 to 10 (7+ = hot lead ready for a call).\n4. Write a short, warm reply (max 80 words) that answers their question and invites them to book a call.\n\nReturn ONLY valid JSON, no markdown, in this exact shape:\n{\"score\": 8, \"need\": \"...\", \"budget\": \"...\", \"timeline\": \"...\", \"summary\": \"one line summary\", \"reply\": \"message to send to the lead\"}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        460,
        300
      ],
      "name": "Lead Qualifier Agent",
      "id": "857e5230-0bf2-40c6-81c1-a3882bda8254"
