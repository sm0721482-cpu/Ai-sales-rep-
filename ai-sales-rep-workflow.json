    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().slice(0, 10);\nconst rows = $input.all().map(i => i.json).filter(r => String(r.createdAt || '').startsWith(today));\nconst hot = rows.filter(r => r.status === 'HOT').length;\nconst text = `📊 Daily Sales Report\\nNew leads today: ${rows.length}\\nHot leads (AI called): ${hot}\\nWarm leads (in follow-up): ${rows.length - hot}`;\nreturn [{ json: { text } }];"
      },
