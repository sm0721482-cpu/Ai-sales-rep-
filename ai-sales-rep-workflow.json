    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.output || '');\nlet d;\ntry {\n  d = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  d = { score: 5, need: '', budget: '', timeline: '', summary: 'Could not parse AI output', reply: raw };\n}\nconst lead = $('Normalize Lead').first().json;\nconst score = Number(d.score) || 0;\nreturn [{ json: { ...lead, ...d, score, status: score >= 7 ? 'HOT' : 'WARM' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
